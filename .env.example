# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > Web app.
# Leave these empty to run in demo mode (data stays in your browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Show the eight sample agent profiles in the directory (true/false).
VITE_SHOW_SAMPLE_AGENTS=true
